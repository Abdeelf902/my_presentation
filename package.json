{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node vercel-build.js",
    "postbuild": "react-snap",
    "build:seo": "node scripts/build-seo.js",
    "generate:sitemap": "npx tsx scripts/generate-sitemap.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "vercel-build": "npm run build",
    "audit:check": "npm audit --audit-level=moderate"
  },
  "reactSnap": {
    "source": "dist",
    "inlineCss": true,
    "destination": "dist",
    "include": [
      "/",
      "/about",
      "/services",
      "/projects",
      "/experience",
      "/contact",
      "/faq",
      "/zones-intervention",
      "/mentions-legales",
      "/cgv",
      "/developpeur-angular-freelance",
      "/developpeur-laravel-freelance",
      "/creation-site-web-yvelines",
      "/applications-web-sur-mesure",
      "/blog",
      "/blog/pourquoi-angular-application-metier",
      "/blog/laravel-vs-nodejs-quel-choisir",
      "/blog/combien-coute-developpeur-freelance",
      "/blog/creer-application-web-sur-mesure",
      "/blog/seo-technique-optimiser-react"
    ]
  },
  "dependencies": {
    "@tanstack/react-router": "^1.168.22",
    "@tanstack/router-vite-plugin": "^1.166.37",
    "cookie": "^1.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^10.18.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-intersection-observer": "^9.5.3",
    "resend": "^6.6.0",
    "swiper": "^12.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.5",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^13.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "puppeteer": "^25.10.0",
    "react-snap": "^1.13.1",
    "rollup": "^4.21.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^3.4.1",
    "terser": "^5.44.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.2.4",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-prerender": "^1.0.8"
  },
  "overrides": {
    "node-fetch": "^3.3.2",
    "@vercel/node": {
      "node-fetch": "^3.3.2",
      "path-to-regexp": "^8.0.0"
    }
  }
}
